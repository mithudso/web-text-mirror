# Environment variables read by scripts/text_mirror.py (all optional).
# Copy to .env and source it, or export in your shell; the script reads os.environ
# directly (it does not load .env itself).

# Seconds between requests (default 1.0). CLI --delay overrides.
CRAWL_DELAY=1.0

# Per-site crawl depth limit in hops; 0 = unlimited (default). CLI --max-depth overrides.
MAX_DEPTH=0

# Used by scripts/install.sh only: which python to pre-provision (default: python3).
PYTHON=python3
